# Copy this file to `.env` (in the repository root) and fill in your own values.
# `.env` is git-ignored — never commit real tokens.

# GitHub personal access token, used by the landscape scraper/extractor
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Hugging Face access token, used for dataset/model download and upload
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Stack Exchange API key, used by the StackOverflow extractor
# https://stackapps.com/apps/oauth/register
API_KEY=
