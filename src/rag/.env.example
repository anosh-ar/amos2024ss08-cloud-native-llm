# Copy to src/rag/.env and adjust. Every value is optional (defaults in config.py).

# --- LLM: any OpenAI-compatible server ---
# Ollama (Windows/macOS/Linux, no Docker needed)
RAG_LLM_BASE_URL=http://localhost:11434/v1
RAG_LLM_MODEL=deepcncf
# LocalAI (Docker, see src/scripts/GUI/preparation_scripts.sh)
# RAG_LLM_BASE_URL=http://localhost:8080/v1
# RAG_LLM_MODEL=DeepCNCFQuantized
RAG_LLM_API_KEY=not-needed
RAG_LLM_TEMPERATURE=0.2
RAG_LLM_MAX_TOKENS=512

# --- Retrieval ---
RAG_EMBED_MODEL=BAAI/bge-small-en-v1.5
RAG_TOP_K=4
RAG_CHUNK_TOKENS=400
RAG_CHUNK_OVERLAP=50
